module

public import Mathlib.Probability.Independence.Basic
public import Mathlib.Probability.Moments.Variance
public import Mathlib.Probability.Martingale.OptionalStopping
public import Mathlib.Probability.Independence.Integration

/-!
# Kolmogorov (1928), *Über die Summen durch den Zufall bestimmter unabhängiger Größen*

Entry: `entries/probability/1928-kolmogorov-summen/`.

**Kolmogorov's maximal inequality.** Let `X₀, …, Xₙ` be independent, square-integrable,
mean-zero random variables and `Sₖ = X₀ + ⋯ + Xₖ`. For every `ε > 0`,
`P(max_{k ≤ n} |Sₖ| ≥ ε) ≤ (Var X₀ + ⋯ + Var Xₙ) / ε²`.

Compared with Chebyshev's inequality for `Sₙ` alone, the bound is the same but the
event is much larger: it controls the whole path `S₀, …, Sₙ`.

**Formal version.** The variables are measurable functions on a probability space (as in
Kolmogorov's setting); independence is `iIndepFun X μ`. The maximum is `Finset.sup'`.

**Proof.** We go through martingales rather than Kolmogorov's original first-passage argument:

1. `Sₖ²` is a submartingale for the natural filtration `𝒢ₖ = σ(X₀, …, Xₖ)`. For `i ≤ j` and
   `s ∈ 𝒢ᵢ`, write `Sⱼ = Sᵢ + R` with `R = X_{i+1} + ⋯ + Xⱼ`. Then
   `∫ₛ Sⱼ² = ∫ₛ Sᵢ² + 2 E[1ₛ Sᵢ · R] + ∫ₛ R²`. The middle term is `2 E[1ₛ Sᵢ] E[R] = 0`,
   because `1ₛ Sᵢ` depends only on `X₀, …, Xᵢ`, `R` only on `X_{i+1}, …, Xⱼ`, and `E[R] = 0`.
   The last term is `≥ 0`.
2. Doob's maximal inequality (`MeasureTheory.maximal_ineq`) gives
   `ε² P(max Sₖ² ≥ ε²) ≤ ∫_{max Sₖ² ≥ ε²} Sₙ² ≤ E[Sₙ²]`.
3. `E[Sₙ²] = Var Sₙ = ∑ Var Xᵢ` by independence, and `max Sₖ² ≥ ε²` iff `max |Sₖ| ≥ ε`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Finset
open scoped NNReal ENNReal

namespace SovietLean.Kolmogorov1928

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- Partial sums `S k = X 0 + ⋯ + X k`. -/
def partialSum (X : ℕ → Ω → ℝ) (k : ℕ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.range (k + 1), X i ω

omit mΩ [IsProbabilityMeasure μ] in
theorem partialSum_eq (X : ℕ → Ω → ℝ) (k : ℕ) :
    partialSum X k = ∑ i ∈ range (k + 1), X i := by
  funext ω; simp [partialSum, Finset.sum_apply]

omit mΩ [IsProbabilityMeasure μ] in
/-- `S j = S i + ∑_{i < l ≤ j} X l`. -/
theorem partialSum_add_block (X : ℕ → Ω → ℝ) {i j : ℕ} (hij : i ≤ j) (ω : Ω) :
    partialSum X j ω = partialSum X i ω + ∑ l ∈ Ico (i + 1) (j + 1), X l ω := by
  simp only [partialSum]
  rw [Finset.sum_range_add_sum_Ico _ (by omega)]

/-- The natural filtration of the sequence. -/
noncomputable def filt (X : ℕ → Ω → ℝ) (hmeas : ∀ i, Measurable (X i)) : Filtration ℕ mΩ :=
  Filtration.natural (fun i ↦ X i) (fun i ↦ (hmeas i).stronglyMeasurable)

omit [IsProbabilityMeasure μ] in
theorem measurable_partialSum_filt (X : ℕ → Ω → ℝ) (hmeas : ∀ i, Measurable (X i)) (k : ℕ) :
    Measurable[filt X hmeas k] (partialSum X k) := by
  change Measurable[filt X hmeas k] fun ω ↦ ∑ i ∈ range (k + 1), X i ω
  refine Finset.measurable_sum _ fun i hi ↦ ?_
  have hik : i ≤ k := by simp at hi; omega
  exact ((Filtration.stronglyAdapted_natural (fun i ↦ (hmeas i).stronglyMeasurable) i).mono
    ((filt X hmeas).mono hik)).measurable

/-- The σ-algebra generated by `X (i+1), …, X j`. -/
abbrev block (X : ℕ → Ω → ℝ) (i j : ℕ) : MeasurableSpace Ω :=
  ⨆ l ∈ Set.Ico (i + 1) (j + 1), MeasurableSpace.comap (X l) inferInstance

omit mΩ [IsProbabilityMeasure μ] in
theorem measurable_block_sum (X : ℕ → Ω → ℝ) (i j : ℕ) :
    Measurable[block X i j] (fun ω ↦ ∑ l ∈ Ico (i + 1) (j + 1), X l ω) := by
  refine Finset.measurable_sum _ fun l hl ↦ ?_
  have : MeasurableSpace.comap (X l) inferInstance ≤ block X i j :=
    le_iSup₂ (f := fun l (_ : l ∈ Set.Ico (i + 1) (j + 1)) ↦
      MeasurableSpace.comap (X l) (inferInstance : MeasurableSpace ℝ)) l (by simpa using hl)
  exact (comap_measurable (X l)).mono this le_rfl

omit [IsProbabilityMeasure μ] in
theorem indep_filt_block (X : ℕ → Ω → ℝ) (hmeas : ∀ i, Measurable (X i)) (hind : iIndepFun X μ)
    (i j : ℕ) : Indep (filt X hmeas i) (block X i j) μ := by
  have h := indep_iSup_of_disjoint (m := fun l ↦ MeasurableSpace.comap (X l) inferInstance)
    (fun l ↦ (hmeas l).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 hind)
    (S := Set.Iic i) (T := Set.Ico (i + 1) (j + 1))
    (Set.disjoint_left.2 fun l h1 h2 ↦ by simp at h1 h2; omega)
  exact h

/-- **Key step**: `S k²` is a submartingale for the natural filtration. -/
theorem submartingale_sq (X : ℕ → Ω → ℝ) (hmeas : ∀ i, Measurable (X i))
    (hX : ∀ i, MemLp (X i) 2 μ) (hmean : ∀ i, ∫ ω, X i ω ∂μ = 0) (hind : iIndepFun X μ) :
    Submartingale (fun k ω ↦ partialSum X k ω ^ 2) (filt X hmeas) μ := by
  have hS : ∀ k, MemLp (partialSum X k) 2 μ := fun k ↦ by
    rw [partialSum_eq]; exact memLp_finsetSum' _ fun i _ ↦ hX i
  have hR : ∀ i j, MemLp (fun ω ↦ ∑ l ∈ Ico (i + 1) (j + 1), X l ω) 2 μ := fun i j ↦
    memLp_finsetSum _ fun l _ ↦ hX l
  refine submartingale_of_setIntegral_le ?_ (fun k ↦ (hS k).integrable_sq) ?_
  · intro k
    exact ((measurable_partialSum_filt X hmeas k).pow_const 2).stronglyMeasurable
  · intro i j hij s hs
    set R : Ω → ℝ := fun ω ↦ ∑ l ∈ Ico (i + 1) (j + 1), X l ω with hRdef
    have hsm : MeasurableSet s := (filt X hmeas).le i s hs
    -- E[R] = 0
    have hRmean : ∫ ω, R ω ∂μ = 0 := by
      rw [hRdef, integral_finsetSum _ fun l _ ↦ (hX l).integrable one_le_two]
      simp [hmean]
    -- the cross term vanishes, by independence
    have hcross : ∫ ω in s, partialSum X i ω * R ω ∂μ = 0 := by
      rw [← integral_indicator hsm]
      have hind' : IndepFun (s.indicator (partialSum X i)) R μ := by
        rw [IndepFun_iff_Indep]
        refine indep_of_indep_of_le_right
          (indep_of_indep_of_le_left (indep_filt_block X hmeas hind i j) ?_) ?_
        · exact ((measurable_partialSum_filt X hmeas i).indicator hs).comap_le
        · exact (measurable_block_sum X i j).comap_le
      have : s.indicator (fun ω ↦ partialSum X i ω * R ω) =
          s.indicator (partialSum X i) * R := by
        funext ω; by_cases hω : ω ∈ s <;> simp [hω]
      rw [this, hind'.integral_mul_eq_mul_integral, hRmean, mul_zero]
      · exact ((hS i).aestronglyMeasurable).indicator hsm
      · exact (hR i j).aestronglyMeasurable
    have hSR : Integrable (fun ω ↦ partialSum X i ω * R ω) μ := (hS i).integrable_mul (hR i j)
    have hR2 : Integrable (fun ω ↦ R ω ^ 2) μ := (hR i j).integrable_sq
    have hexp : ∀ ω, partialSum X j ω ^ 2 =
        partialSum X i ω ^ 2 + (2 * (partialSum X i ω * R ω) + R ω ^ 2) := by
      intro ω; rw [partialSum_add_block X hij ω]; ring
    have hg : Integrable (fun ω ↦ 2 * (partialSum X i ω * R ω) + R ω ^ 2) μ :=
      (hSR.const_mul 2).add hR2
    have hg2 : Integrable (fun ω ↦ 2 * (partialSum X i ω * R ω)) μ := hSR.const_mul 2
    simp_rw [hexp]
    rw [integral_add ((hS i).integrable_sq.integrableOn) hg.integrableOn,
      integral_add hg2.integrableOn hR2.integrableOn, integral_const_mul, hcross]
    have : 0 ≤ ∫ ω in s, R ω ^ 2 ∂μ := setIntegral_nonneg hsm fun ω _ ↦ sq_nonneg _
    linarith

/-- **Kolmogorov's maximal inequality.** -/
theorem maximal_inequality (X : ℕ → Ω → ℝ) (hmeas : ∀ i, Measurable (X i))
    (hX : ∀ i, MemLp (X i) 2 μ)
    (hmean : ∀ i, ∫ ω, X i ω ∂μ = 0) (hind : iIndepFun X μ) (n : ℕ) {ε : ℝ} (hε : 0 < ε) :
    μ.real {ω | ε ≤ (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
        (fun k ↦ |partialSum X k ω|)}
      ≤ (∑ i ∈ Finset.range (n + 1), variance (X i) μ) / ε ^ 2 := by
  have hsub := submartingale_sq X hmeas hX hmean hind
  set ε2 : ℝ≥0 := ⟨ε ^ 2, by positivity⟩ with hε2
  have hmax := maximal_ineq hsub (fun k ω ↦ sq_nonneg _) (ε := ε2) n
  -- the two events agree
  have hset : {ω | ε ≤ (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
        (fun k ↦ |partialSum X k ω|)} =
      {ω | (ε2 : ℝ) ≤ (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
        (fun k ↦ partialSum X k ω ^ 2)} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Finset.le_sup'_iff]
    refine exists_congr fun k ↦ and_congr_right fun _ ↦ ?_
    rw [← sq_abs (partialSum X k ω)]
    exact (sq_le_sq₀ hε.le (abs_nonneg _)).symm
  rw [← hset] at hmax
  set A := {ω | ε ≤ (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
        (fun k ↦ |partialSum X k ω|)}
  -- E[S_n²] = ∑ Var X_i
  have hS : MemLp (partialSum X n) 2 μ := by
    rw [partialSum_eq]; exact memLp_finsetSum' _ fun i _ ↦ hX i
  have hvar : ∫ ω, partialSum X n ω ^ 2 ∂μ = ∑ i ∈ range (n + 1), variance (X i) μ := by
    have h0 : ∫ ω, partialSum X n ω ∂μ = 0 := by
      change ∫ ω, ∑ i ∈ range (n + 1), X i ω ∂μ = 0
      rw [integral_finsetSum _ fun i _ ↦ (hX i).integrable one_le_two]
      simp [hmean]
    have := variance_of_integral_eq_zero hS.aemeasurable h0
    rw [← IndepFun.variance_sum (fun i _ ↦ hX i)
      (fun i _ j _ hij ↦ hind.indepFun hij), ← partialSum_eq, this]
  have hle : ∫ ω in A, partialSum X n ω ^ 2 ∂μ ≤ ∑ i ∈ range (n + 1), variance (X i) μ := by
    rw [← hvar]
    exact setIntegral_le_integral hS.integrable_sq (Filter.Eventually.of_forall fun ω ↦ sq_nonneg _)
  have hreal : ε ^ 2 * μ.real A ≤ ∫ ω in A, partialSum X n ω ^ 2 ∂μ := by
    have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top hmax
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (setIntegral_nonneg_of_ae
      (Filter.Eventually.of_forall fun ω ↦ sq_nonneg _)), ENNReal.coe_toReal] at h
  rw [le_div_iff₀ (by positivity)]
  linarith

end SovietLean.Kolmogorov1928

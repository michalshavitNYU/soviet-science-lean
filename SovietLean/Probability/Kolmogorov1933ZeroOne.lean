module

public import Mathlib.Probability.Independence.ZeroOne

/-!
# Kolmogorov (1933), *Grundbegriffe der Wahrscheinlichkeitsrechnung*, Appendix: the 0-1 law

Entry: `entries/probability/1933-kolmogorov-grundbegriffe/`.

**Statement in the source (paraphrased).** Let `x₁, x₂, …` be independent random variables
and let `A` be an event whose occurrence is determined by the sequence but is not affected
by changing any finite number of its terms. Then `P(A) = 0` or `P(A) = 1`.

**Formal version.** "Not affected by finitely many terms" is the tail σ-algebra
`limsup s atTop = ⋂ n, ⨆ i ≥ n, s i`, where `s i` is the σ-algebra generated by the
`i`-th variable. We state it for an independent sequence of σ-algebras, which covers the
random-variable version by taking `s i = MeasurableSpace.comap (x i) inferInstance`.

The proof is Mathlib's (`ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop`,
by Rémy Degenne); this file records the match between the source and the library statement.
-/

@[expose] public section

open MeasureTheory Filter

namespace SovietLean.Kolmogorov1933

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- **Kolmogorov's 0-1 law** (Grundbegriffe, Appendix). A tail event of an independent
sequence of σ-algebras has probability 0 or 1. -/
theorem zero_one_law (s : ℕ → MeasurableSpace Ω) (h_le : ∀ n, s n ≤ m0)
    (h_indep : ProbabilityTheory.iIndep s μ) {A : Set Ω}
    (hA : MeasurableSet[limsup s atTop] A) :
    μ A = 0 ∨ μ A = 1 :=
  ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop h_le h_indep hA

/-- The random-variable form: a tail event of an independent sequence of real random
variables has probability 0 or 1. -/
theorem zero_one_law_of_random_variables (x : ℕ → Ω → ℝ) (hx : ∀ n, Measurable (x n))
    (h_indep : ProbabilityTheory.iIndepFun x μ) {A : Set Ω}
    (hA : MeasurableSet[limsup (fun n ↦ MeasurableSpace.comap (x n) inferInstance) atTop] A) :
    μ A = 0 ∨ μ A = 1 :=
  zero_one_law _ (fun n ↦ (hx n).comap_le) h_indep hA

end SovietLean.Kolmogorov1933
